{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "結果：4位相を別々に表示（再計算なし・最新の結果）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulate.py",
      "args": [
        "--plot-only",
        "latest"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "照射像：Windows互換CPU（LLVM不要・低サンプル）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulate.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/current.json",
        "--variant",
        "scalar_rgb",
        "--spp",
        "64",
        "--case",
        "baseline",
        "--phase",
        "0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "照射像：プレビュー（設定JSON）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulate.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/current.json",
        "--mode",
        "preview"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "照射像：高品質（時間がかかります）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulate.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/current.json",
        "--mode",
        "quality"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "照射像：設定値の検査のみ",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulate.py",
      "args": [
        "--config",
        "${workspaceFolder}/configs/current.json",
        "--validate-only"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
